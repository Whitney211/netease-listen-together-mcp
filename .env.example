# 复制在浏览器登录 music.163.com 后的 Cookie (必填，需包含 MUSIC_U 与 __csrf)
NETEASE_COOKIE="MUSIC_; __csrf=c7ef7ed114be2b47c429b32591fea2a6"

# 接收一起听邀请的网易云数字用户 ID (选填: 纯 HTTP 模式下若未入房，会自动接受该用户发来的私信邀请卡片)
NETEASE_LISTEN_TOGETHER_ACCEPTOR_ID="1941742149"

# 反向代理 Bearer 鉴权 Token (选填: 用于 Nginx 反向代理校验，可运行 openssl rand -hex 32 生成)
MCP_AUTH_TOKEN="5f48e032a76129cc41208b43029f7528791ed452070804b42c29024610019a7c"
